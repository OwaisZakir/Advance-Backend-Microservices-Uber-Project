# ====================================================
#              ⚙️ Server Configuration
# ====================================================
PORT=4000                      # Express server port
NODE_ENV=development            # development | production

# ====================================================
#              💾 Database Configuration
# ====================================================
MONGODB_URI=mongodb://localhost:27017/advance-backend-microservices-uber-project

# ====================================================
#              🔑 Authentication & Security
# ====================================================
JWT_SECRET=uber-user-secret   # Secret key for JWT authentication
JWT_EXPIRES_IN=24h               # Token expiry (e.g., 1h, 7d)

# ====================================================
#              📩 Email Service (Optional)
# ====================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=yourEmail@gmail.com
MAIL_PASS=yourEmailPassword

# ====================================================
#              ☁️ Cloud Storage (Optional)
# ====================================================
CLOUD_PROVIDER=aws              # aws | gcp | azure | cloudinary
CLOUD_BUCKET=my-bucket-name
CLOUD_ACCESS_KEY=yourAccessKey
CLOUD_SECRET_KEY=yourSecretKey

# ====================================================
#              💳 Payment Gateway (Optional)
# ====================================================
STRIPE_SECRET_KEY=yourStripeSecretKey
PAYPAL_CLIENT_ID=yourPaypalClientId
PAYPAL_SECRET=yourPaypalSecret

# ====================================================
#              📱 Third Party APIs (Optional)
# ====================================================
GOOGLE_MAPS_API_KEY=yourGoogleMapsKey
FIREBASE_API_KEY=yourFirebaseApiKey
